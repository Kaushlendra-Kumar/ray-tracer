{
  "name": "Soft shadows",
  "description": "A large spherical area light produces wide penumbrae; a small one produces tight shadows. Same objects, two lights of different size.",
  "camera": { "look_from": [0, 3.2, 6], "look_at": [0, 0.5, 0], "vfov": 40 },
  "render": { "width": 720, "height": 405, "spp": 256, "max_depth": 6, "integrator": "path", "tone_map": "aces", "exposure": 1.0 },
  "background": { "type": "solid", "color": [0.01, 0.01, 0.015] },
  "materials": {
    "floor": { "type": "lambertian", "albedo": [0.8, 0.8, 0.8] },
    "obj":   { "type": "lambertian", "albedo": [0.8, 0.55, 0.3] },
    "obj2":  { "type": "lambertian", "albedo": [0.3, 0.5, 0.8] },
    "big_light":   { "type": "emissive", "color": [1.0, 0.85, 0.7], "intensity": 3.0 },
    "small_light": { "type": "emissive", "color": [0.7, 0.85, 1.0], "intensity": 120.0 }
  },
  "objects": [
    { "type": "plane", "name": "floor", "point": [0, 0, 0], "normal": [0, 1, 0], "material": "floor" },
    { "type": "sphere", "name": "ball", "center": [-1.4, 0.6, 0], "radius": 0.6, "material": "obj" },
    { "type": "box", "name": "block", "min": [-0.4, 0, -0.4], "max": [0.4, 1.4, 0.4], "rotate_y": 20, "material": "obj2" },
    { "type": "mesh", "name": "torus", "source": "torus", "major_radius": 0.5, "minor_radius": 0.18, "segments": 64, "translate": [1.5, 0.18, 0.2], "material": "obj" },
    { "type": "sphere", "name": "big light", "center": [-3, 4, 1.5], "radius": 1.2, "material": "big_light" },
    { "type": "sphere", "name": "small light", "center": [3.5, 4, 1.0], "radius": 0.12, "material": "small_light" }
  ]
}
